# ZL-CRM chạy local trong TAKI Agentic AI — mẫu cho `pnpm bootstrap` (các giá trị __...__ được sinh ngẫu nhiên).
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:5174
JWT_SECRET=__JWT_SECRET__
ENCRYPTION_KEY=__ENCRYPTION_KEY__
DATABASE_URL=postgresql://zlcrm:__DB_PASSWORD__@localhost:5432/zalocrm
UPLOAD_DIR="../data/files"
# Redis để trống = chế độ in-memory (đủ cho 1 máy)
REDIS_URL=
# MinIO/S3 chưa cài: tin chữ hoạt động; đính kèm ảnh/video cần MinIO
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=zalocrm-attachments
# AI của ZL-CRM dùng tài khoản Claude CLI đã đăng nhập (giống hệ thống Agentic AI)
AI_DEFAULT_PROVIDER=claude-cli
CLAUDE_CLI_ENABLED=1
CLAUDE_CLI_MODEL=claude-sonnet-4-6
# Tài khoản quản trị ZL-CRM (đổi mật khẩu sau khi đăng nhập)
BOOTSTRAP_ADMIN_PHONE=0900000001
BOOTSTRAP_ADMIN_PASSWORD=__ADMIN_PASSWORD__
BOOTSTRAP_ADMIN_NAME="Quản trị TAKI"
BOOTSTRAP_ORG_NAME="TAKI Group"
