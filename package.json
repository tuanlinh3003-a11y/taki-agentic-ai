{
  "name": "dotaka-agentic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch --env-file-if-exists=.env apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "start": "pnpm build:web && tsx --env-file-if-exists=.env apps/api/src/server.ts",
    "seed": "tsx --env-file-if-exists=.env apps/api/src/seed.ts --reset",
    "seed:blank": "tsx --env-file-if-exists=.env apps/api/src/seed.ts --reset --blank",
    "mcp": "tsx --env-file-if-exists=.env apps/mcp-server/src/index.ts",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bootstrap": "node scripts/bootstrap.mjs",
    "skills:export": "tsx scripts/export-skills.ts",
    "zlcrm:connect": "node scripts/zlcrm-connect.mjs",
    "verify": "pnpm run typecheck && pnpm test && pnpm run build:web",
    "workspace:export": "tsx --env-file-if-exists=.env scripts/export-workspace.ts"
  },
  "dependencies": {
    "@dotaka/agents": "workspace:*",
    "@dotaka/chat-engine": "workspace:*",
    "@dotaka/connectors": "workspace:*",
    "@dotaka/contracts": "workspace:*",
    "@dotaka/db": "workspace:*",
    "@dotaka/jev": "workspace:*",
    "@dotaka/llm-gateway": "workspace:*",
    "@dotaka/orchestrator": "workspace:*",
    "@dotaka/rule-engine": "workspace:*",
    "@dotaka/scoring": "workspace:*",
    "@dotaka/shared": "workspace:*",
    "@dotaka/skills": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
