# ===== DOTAKA Agentic AI =====
# Để trống = chạy chế độ SANDBOX (không gọi AI thật, nền tảng giả lập). Điền key để chạy thật.

# Claude (LLM Gateway) — MỌI AI agent chạy qua Claude Code CLI: tài khoản Claude đang đăng nhập trên máy (lệnh `claude`),
# KHÔNG dùng API key Anthropic. claude_cli (mặc định) · sandbox = không gọi AI (thử quy trình). Đổi được trong Cài đặt.
LLM_PROVIDER=claude_cli
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_CONCURRENCY=2

# Jev / TypeSafe System One — phán đoán nhanh: phân loại, chấm điểm, guardrail
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Bảng tầng mô hình (đổi không cần sửa agent)
# Model mặc định theo tầng (đổi trong Cài đặt → Model Claude, hoặc riêng từng agent)
LLM_MODEL_LARGE=claude-opus-5
LLM_MODEL_MEDIUM=claude-sonnet-5
LLM_MODEL_SMALL=claude-haiku-4-5

API_PORT=8787
DB_PATH=data/dotaka.db
# Khóa mã hóa token nền tảng (32 byte hex). Production: lấy từ KMS/vault.
TOKEN_ENCRYPTION_KEY=
# Bí mật ký webhook (mỗi nền tảng một bí mật trong production)
WEBHOOK_SECRET=dev-webhook-secret
# Telegram cảnh báo (tùy chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lần chạy đầu: blank = DNA + skill + cấu hình TAKI, không có dữ liệu mẫu (demo = kèm dữ liệu mẫu)
SEED_MODE=blank
